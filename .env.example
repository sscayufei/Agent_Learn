# 环境变量示例，不包含可直接使用的真实密钥；复制为本地 .env 后再填写，切勿把真实 .env 打包或上传。
# 前端 NEXT_PUBLIC_ 前缀会进入浏览器构建，不能用来存令牌；模型/仓库密钥只应由后端持有。
# 端口、模型名、阈值和口令保持原包原值；本注释版不会替你切换服务、模型或索引配置。
APP_ENV=development
APP_NAME=DevFlow AI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

DATABASE_URL=postgresql+psycopg://devflow:devflow@localhost:5432/devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# Workflow planning, semantic review and synthesis share the LLM_* configuration.
WORKFLOW_MODEL_TIMEOUT_SECONDS=60
WORKFLOW_MODEL_MAX_INPUT_CHARS=60000
WORKFLOW_OBSERVER_TIMEOUT_SECONDS=20
WORKFLOW_OBSERVER_MAX_OUTPUT_TOKENS=1800
WORKFLOW_SYNTHESIS_MODEL_ENABLED=false
WORKFLOW_REPLAN_MODEL_ENABLED=false
WORKFLOW_TASK_TIMEOUT_SECONDS=90

# openai_compatible: call EMBEDDING_BASE_URL/embeddings.
# local: use sentence-transformers and LOCAL_EMBEDDING_MODEL.
# deterministic: local hash fallback for demos/tests only.
# openai_compatible: call EMBEDDING_BASE_URL/embeddings.
# local: use sentence-transformers and LOCAL_EMBEDDING_MODEL.
# deterministic: local hash fallback for demos/tests only.
# openai_compatible: call EMBEDDING_BASE_URL/embeddings.
# local: use sentence-transformers and LOCAL_EMBEDDING_MODEL.
# deterministic: local hash fallback for demos/tests only.
EMBEDDING_PROVIDER=qwen_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 维度必须与当前 Embedding 模型输出和 Milvus 集合契约一致；更换模型后要按流程重建索引。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DEVICE=

MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=devflow_rag_qwen1024
RAG_RERANK_TOP_N=24
# Native Ragas evaluation. Judge settings fall back to the LLM_* values when blank.
RAGAS_ENABLED=true
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_MODEL=
RAGAS_TIMEOUT_SECONDS=120
RAGAS_JUDGE_MAX_TOKENS=8192
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1
RAGAS_MAX_CASES=5
RAGAS_CONTEXT_PRECISION_MIN=0.75
RAGAS_CONTEXT_RECALL_MIN=0.80
RAGAS_FAITHFULNESS_MIN=0.90
RAGAS_ANSWER_RELEVANCY_MIN=0.80
RAGAS_AGENT_GOAL_ACCURACY_MIN=0.80
RAGAS_TOOL_CALL_ACCURACY_MIN=0.90
RAGAS_TOOL_CALL_F1_MIN=0.90
# 输入预算、回答预留与动态窗口共同控制上下文压力；增加预算不代表模型真实窗口也随之变大。
CONTEXT_MAX_INPUT_TOKENS=24000
CONTEXT_RESERVED_RESPONSE_TOKENS=3000
CONTEXT_DYNAMIC_MODEL_WINDOW_ENABLED=true
CONTEXT_MODEL_WINDOW_TOKENS=0
CONTEXT_COMPACT_RESERVED_OUTPUT_TOKENS=12000
CONTEXT_AUTO_COMPACT_ENABLED=true
CONTEXT_WARNING_BUFFER_TOKENS=20000
CONTEXT_AUTO_COMPACT_BUFFER_TOKENS=13000
CONTEXT_AGGRESSIVE_BUFFER_TOKENS=8000
CONTEXT_MANUAL_BUFFER_TOKENS=3000
CONTEXT_MAX_COMPACTION_FAILURES=3
CONTEXT_MICROCOMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_SUMMARY_TOKENS=1800
CONTEXT_SYSTEM_RATIO=0.12
CONTEXT_MEMORY_RATIO=0.22
CONTEXT_EVIDENCE_RATIO=0.34
CONTEXT_RECENT_RATIO=0.22
CONTEXT_TOOL_RATIO=0.10
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_KEY=devflow-agent-v1
PROMPT_CACHE_RETENTION=
REPO_CHECKOUT_DIR=.data/repos
UPLOAD_DIR=.data/uploads

# 仅为演示占位值；运行方需自行设置并保护加密密钥，已有密文能否解开也依赖同一密钥。
TOKEN_ENCRYPTION_KEY=change-me-in-local-dev
DEMO_MODE=false
GITHUB_WEBHOOK_SECRET=

# Optional: send negative answer feedback to a Feishu custom-bot webhook.
FEISHU_FEEDBACK_WEBHOOK_URL=
# Public backend origin used to build the trace link in group notifications.
FEEDBACK_TRACE_BASE_URL=http://localhost:8000
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=300
# 默认同步全部分页；需要限制每类主记录总数时再启用（会报告 partial）。
# AUTO_SYNC_LIMIT=50

# 默认同步全部分页；需要限制每类主记录总数时再启用（会报告 partial）。
# AUTO_SYNC_LIMIT=50
# 默认同步全部分页；需要限制每类主记录总数时再启用（会报告 partial）。
# AUTO_SYNC_LIMIT=50
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
